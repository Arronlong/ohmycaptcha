# 使用 Playwright 支持的 Debian 12，避免 Bullseye 安全更新包下载返回 404。
FROM python:3.11-slim-bookworm

WORKDIR /app

# 先安装项目锁定版本的 Playwright，再由它安装配套的浏览器和系统依赖。
COPY requirements.txt .
RUN pip install --no-cache-dir --root-user-action=ignore -r requirements.txt

# 使用 HTTPS 软件源，不再手工维护浏览器依赖列表。
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources && \
    DEBIAN_FRONTEND=noninteractive playwright install --with-deps chromium && \
    rm -rf /var/lib/apt/lists/*

# 构建时真正启动 Chromium，提前发现缺失动态库或浏览器无法启动的问题。
RUN python -c "from playwright.sync_api import sync_playwright; p = sync_playwright().start(); browser = p.chromium.launch(headless=True, args=['--no-sandbox']); print(browser.version); browser.close(); p.stop()"

COPY . .

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
